  "version": "1.0.0",
  "homepage": "https://sobhankhandehroo8183-lab.github.io/smart-vet",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
